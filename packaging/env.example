# Logo.dev MCP environment configuration
#
# Installed to /etc/logodev-mcp/env.example.
# Copy to /etc/logodev-mcp/env and edit for your deployment; the systemd
# unit (/usr/lib/systemd/system/logodev-mcp.service) sources
# /etc/logodev-mcp/env via EnvironmentFile=.

# --- Logging ---
# Log level for FastMCP internals and app loggers (DEBUG / INFO / WARNING / ERROR / CRITICAL). The -v CLI flag overrides to DEBUG.
FASTMCP_LOG_LEVEL=INFO
# Set false for plain or structured JSON log output.
FASTMCP_ENABLE_RICH_LOGGING=true

# --- Domain ---
# All domain env vars use the LOGODEV_MCP_ prefix.
# See the README and `logodev-mcp serve --help` for the full list.
#
# Example:
# LOGODEV_MCP_EXAMPLE_VAR=value
