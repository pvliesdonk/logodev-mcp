# OIDC authentication example. See docs/guides/authentication.md for setup.

# Public base URL of the deployed server, e.g. `https://mcp.example.com`. Required for OIDC. Also the fallback source of the MCP Apps domain when `app_domain` is unset.
LOGODEV_MCP_BASE_URL=https://mcp.example.com
# OIDC discovery document URL, e.g. `https://auth.example.com/.well-known/openid-configuration`.
LOGODEV_MCP_OIDC_CONFIG_URL=https://auth.example.com/.well-known/openid-configuration
# OIDC client identifier registered with the provider.
LOGODEV_MCP_OIDC_CLIENT_ID=mcp-client
# OIDC client secret registered with the provider.
LOGODEV_MCP_OIDC_CLIENT_SECRET=your-client-secret
# Expected `aud` claim; tokens issued for another audience are rejected.
LOGODEV_MCP_OIDC_AUDIENCE=mcp-api
# Scopes a caller must present, space- or comma-separated. Defaults to `openid` in oidc-proxy mode.
LOGODEV_MCP_OIDC_REQUIRED_SCOPES=
# Signing key for issued JWTs; used in oidc-proxy mode only. When unset, the key is derived deterministically from `oidc_client_secret`, so tokens survive a restart — but rotating that secret invalidates every issued token. Set this explicitly to decouple token validity from secret rotation. Generate with `openssl rand -hex 32`.
LOGODEV_MCP_OIDC_JWT_SIGNING_KEY=your-signing-key
# Validate the access token instead of the id token.
LOGODEV_MCP_OIDC_VERIFY_ACCESS_TOKEN=false
